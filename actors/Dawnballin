// --------- Dubz comment - there was a lot of text about the projectile, dev was fuuuucked...

// The Basketball projectile is a WeaponGiver because that gives us better
// control of the points that are given. We'll give the player 200 points
// for a rebound, less than picking up a new item but still a nice amount.

class DawnballinProjectile : WeaponGiver
{
	private int throwableFlags;	

	int damageToGlass;
	float glassDamping;
	
	property DamageToGlass 	: damageToGlass;		// Damage caused when passing through or colliding with glass
	property GlassDamping	: glassDamping;	
	
	Default
	{
		Radius 12;
		Height 24;
		Speed 20;
		Damage 0;
		Mass 15;
		Projectile;
		-NOGRAVITY
		-NOBLOCKMAP
		+NOEXTREMEDEATH
		+MTHRUSPECIES
		+BOUNCEONFLOORS
		+BOUNCEONWALLS
		+BOUNCEONCEILINGS
		+ALLOWBOUNCEONACTORS
		+BOUNCEONACTORS
		+USEBOUNCESTATE
		+ROLLSPRITE
		+ROLLCENTER
		+CANBOUNCEWATER
		DamageType "Melee";
		BounceFactor 0.8;
		BounceCount 10;
		BounceSound "weapons/sports/bball/bounce";
		ProjectileKickBack 50;
		Scale 0.3;
		+FORCEXYBILLBOARD
		Inventory.PickupSound "weapons/sports/bball/rebound";
		Inventory.PickupMessage "$GOTBBALLREBOUND";
		DropItem "Dawnballin";
		
		DawnballinProjectile.DropBall "DawnballinDropped";
		DawnballinProjectile.PointsToGive 200;
		+INVENTORY.ALWAYSPICKUP
	}
	
	int PointsToGive;
	Property PointsToGive : PointsToGive;
	
	string DropBall;
	property DropBall : DropBall;
	
	actor collider;
	int countup;
	bool okaypickup;
	bool firstbounce;
	bool healballactive;
	
	// The basketball projectile summons an additional hitbox actor that
	// allows the player to pick up the ball from a further distance than
	// the normal hitbox. This makes it easier for the player to grab rebounds.
	// The collider actor does nothing besides call the Touch function from the
	// basketball projectile and disappear when there's no projectile anymore.
	
	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		collider = Spawn("DawnballinPickupCollider",self.pos-(0,0,8));
		if (collider)
		{
			collider.master = self;
		}
	}
	
	override int SpecialMissileHit (Actor victim) {
		
        if((victim is "Juggernaut") || (victim is "SentryGun") || (victim is "SentryGunAlien")) {
            victim.A_CHANGEVELOCITY(-20,0,8, CVF_RELATIVE);
			victim.DamageMobj(self, target, random(300,400), "explosiveimpact", DMG_NO_PROTECT | DMG_NO_ARMOR | DMG_NO_FACTOR);
			healballactive = true;
        }
		
		if((victim is "CRAWLERMINE") || (victim is "SAWDRONE")) {
			victim.A_CHANGEVELOCITY(-20,0,8, CVF_RELATIVE);
			victim.DamageMobj(self, target, 400, "explosiveimpact", DMG_NO_PROTECT | DMG_NO_ARMOR | DMG_NO_FACTOR);
			healballactive = true;
        }
		
		if(victim is "SelacoEnemy") {
            victim.A_CHANGEVELOCITY(-20,0,8, CVF_RELATIVE);
			victim.DamageMobj(self, target, random(300,400), "meleeimpact", DMG_NO_PROTECT | DMG_NO_ARMOR | DMG_NO_FACTOR);
			healballactive = true;
        }
		
		if(victim is "SelacoExplosivebarrel") {
            victim.A_CHANGEVELOCITY(-5,0,2, CVF_RELATIVE);
			victim.DamageMobj(self, target, 100, "explosiveimpact", DMG_NO_PROTECT | DMG_NO_ARMOR | DMG_NO_FACTOR);
        }
		
		if(victim is "SelacoActor") {
            victim.A_CHANGEVELOCITY(-20,0,8, CVF_RELATIVE);
			victim.DamageMobj(self, target, random(80,150), "meleeimpact", DMG_NO_PROTECT | DMG_NO_ARMOR | DMG_NO_FACTOR);
        }

        return super.SpecialMissileHit(victim);
    }
	
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0
		{
			ThrustThingZ(0,20,0,1);
		}
		Goto Active;
	Active:
		BASB A 1
		{
			A_SetRoll(roll + (abs(self.vel.x) + abs(self.vel.y)));
		}
		Loop;
	Bounce:
		TNT1 A 0
		{
			// Comedy physics: exaggerate the first bounce.
			// Then, be gone with the bounce state.
			
			if (invoker.firstbounce == false)
			{
				ThrustThingZ(0,(abs(self.vel.z*2)),0,1);
				invoker.firstbounce = true;
			}
			bUSEBOUNCESTATE = false;
		}
		goto Active;
	Bounce.Floor:
		TNT1 A 0
		{
			// Don't disable the bounce state when the ball hits the floor.
			// This is to prevent the player from immediately grabbing
			// the ball if they throw it straight down.
			// We also still want to allow the Bounce state so that
			// the player can grab the ball early if it its a WALL,
			// rather than a floor.
			// We use the firstbounce flag to track whether we've done the
			// initial comedy physics bounce.
			
			if (invoker.firstbounce == false)
			{
				ThrustThingZ(0,(abs(self.vel.z*2)),0,1);
				invoker.firstbounce = true;
			}
		}
		goto Active;
		
	Bounce.Player:
		TNT1 A 0
		{
			// Don't disable the bounce state when the ball hits the floor.
			// This is to prevent the player from immediately grabbing
			// the ball if they throw it straight down.
			// We also still want to allow the Bounce state so that
			// the player can grab the ball early if it its a WALL,
			// rather than a floor.
			// We use the firstbounce flag to track whether we've done the
			// initial comedy physics bounce.
			
			if (invoker.firstbounce == false)
			{
				ThrustThingZ(0,(abs(self.vel.z*2)),0,1);
				invoker.firstbounce = true;
			}
		}
		goto Active;
	Death:
		TNT1 A 0 //A_SpawnItemEx("DawnballinDropped");
		{
			// pass our current roll over to the dropped pickup
			actor ball = Actor.Spawn(invoker.DropBall,self.pos);
			ball.roll = self.roll;
		}
		Stop;
	}
	
	// Don't let the player grab their own ball right away.
	// We're overriding the Touch function to prevent any pickup
	// activity by the firing player during the first few tics.
	
	// This should still allow other players to grab the ball,
	// even during the first tics? I haven't tested this,
	// so I'm not 100% sure.
	
	override void Touch(Actor toucher)
	{	
		if (healballactive == true && target && (toucher != target || okaypickup == true) && (toucher is 'dawn'))
		{
			toucher.A_SelectWeapon("Dawnballin");
			toucher.A_GiveInventory("SelacoArmor", 100);
			Dawn(toucher).healPlayer(500);
			Super.Touch(toucher);
		}
		
		if (target && (toucher != target || okaypickup == true) && (toucher is 'dawn'))
		{
			toucher.A_SelectWeapon("Dawnballin");
			Super.Touch(toucher);
		}
	}
	
	// Since we'll always pick up this item regardless,
	// we'll give the points and ReboundCatch item without
	// the need for pickup.
	// Disabling bDROPPED prevents this WeaponGiver from
	// automatically giving us full points.
	override bool TryPickup (in out Actor toucher)
	{
		bDROPPED = false;
		
		toucher.A_GiveInventory("DawnballinReboundCatch", 1);
		toucher.A_SelectWeapon("Dawnballin");
		bool pickup = Super.TryPickup(toucher);
		return pickup;	
	}
	
	override void Tick()
	{
		Super.Tick();
		
		// Start counting up once the ball is active. This will buy some time
		// for the ball to get away from the player before we let them grab it.
		// If the ball projectile has bounced, make it okay to pick up too.
		// That way, we can grab it if it comes back to us right after hitting
		// a wall or monster.
		
		if (okaypickup == false)
		{
			countup++;
			if (countup == 5 || !bUSEBOUNCESTATE)
			{
				okaypickup = true;
			}
		}
			
		if (collider)	// If we have a collider, move it along with the ball.
		{
			collider.SetOrigin(self.pos-(0,0,8),true);
		}
		else			// If we don't have a collider, make one!
		{
			collider = Spawn("DawnballinPickupCollider",self.pos-(0,0,8));
			if (collider)
			{
				collider.master = self;
			}
		}
	}
}

