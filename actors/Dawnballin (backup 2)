// Basketball
class Dawnballin : SelacoWeapon //Splot_Weapon
{
	Default
	{
		WeaponBase.SelectionOrder 2900;
		Radius 12;
		Height 24;
		+FORCEXYBILLBOARD
		+INVENTORY.ALWAYSPICKUP
		Inventory.PickupSound "weapons/sports/bball/select";
		Inventory.PickupMessage "$GOTBBALL";
		Tag "$TAGBASKETBALL";
		WeaponBase.SlotNumber 7;
		WeaponBase.SlotPriority 40;
		Scale 0.3;
		+WEAPONBASE.AMMO_OPTIONAL
		WeaponBase.UpSound "weapons/sports/bball/select";
		Inventory.Icon "WPNBBALL";
		//Splot_Weapon.HudIcon "BBALAMMO";
		SelacoWeapon.HideAmmo true;
		SelacoWeapon.meleeSprite "BASB";
		SelacoWeapon.SlidingSprite "B111";
		SelacoWeapon.BulletDamageToGlass 99999;
		SelacoWeapon.BulletForceToGlass 25;
		-WeaponBase.NO_AUTO_SWITCH;
	}
	
	bool SuperDunkState;
	bool Nogrenadewhileballin;
	bool lookingforrebound;
	bool flydunk;
	double forwardvel;
	double sidevel;
	double pitchdown;
	
	override void throwEquipmentItem()
    {
        if(SuperDunkState || Nogrenadewhileballin)
        {
            return;
        }
        super.throwEquipmentItem();
    }
	
	States
	{
	equip:
	Select:
		BASB B 0 {			
			A_TakeInventory("DawnballinReboundCatch");
			invoker.lookingforrebound = false;
		}
	SelectLoop:
//		BASB B 1 A_SmoothRaise;
		TNT1 A 0 A_EnableWeaponShift();
		BASB B 1 A_Raise(15);
		TNT1 A 0 A_EquipNewWeapon();
		TNT1 A 0 checkPlayerStates();
		TNT1 A 0 S_WeaponReady();
		loop;
	
	Ready:
	ReallyReady:
		TNT1 A 0 {invoker.SuperDunkState = false;}
		TNT1 A 0 {invoker.Nogrenadewhileballin = false;}
		TNT1 A 0 A_TakeInventory("CancelAnimation", 1);
//		TNT1 A 0 A_JumpIfInventory("Reloading",1,"Dribble");
		TNT1 A 0 A_JumpIfInventory("MeleeButton", 1, "AltFire");
		TNT1 A 0 A_JumpIfInventory("ShowHands",1,"HandRemoved");
		TNT1 A 0 A_JumpIfInventory("ShieldEyes",1,"doShieldEyes");
		TNT1 A 0 A_JumpIfInventory("PushButtonNow", 1, "PushButton");
		BASB BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB 1 {
			S_WeaponReady();
			checkPlayerStates();
			S_WeaponOffset();
			A_EnableWeaponShift();
		
			if (CheckInventory("MeleeButton", 1))
			{
			A_STOPSOUND(CHAN_WEAPON);
						SetWeaponState("AltFire");
			}

		}
		BASB B 0 A_JumpIf(self.pos.z == GetZAt(self.pos.x, self.pos.y), "Dribble");
		loop;
	ReloadWeapon:
		TNT1 A 0
		{
			A_TakeInventory("Reloading", 1);
		}
	Dribble:
		TNT1 A 0 {invoker.Nogrenadewhileballin = true;}
		BASB F 2 { A_WeaponOffset(0,36,WOF_INTERPOLATE); S_WeaponReady(WRF_NOBOB); }
		BASB F 2 { A_WeaponOffset(0,55,WOF_INTERPOLATE); S_WeaponReady(WRF_NOBOB); }
		BASB F 2 { A_WeaponOffset(0,80,WOF_INTERPOLATE); S_WeaponReady(WRF_NOBOB); }
		BASB F 2 { A_WeaponOffset(0,120,WOF_INTERPOLATE); S_WeaponReady(WRF_NOBOB); }
		BASB F 2
		{ 
			A_WeaponOffset(0,150,WOF_INTERPOLATE);
			S_WeaponReady(WRF_NOBOB|WRF_DISABLESWITCH);
			A_StartSound("weapons/sports/bball/bounce", CHAN_BODY, CHANF_OVERLAP);
		}
		BASB F 2 { A_WeaponOffset(0,120,WOF_INTERPOLATE); S_WeaponReady(WRF_NOBOB); }
		BASB F 2 { A_WeaponOffset(0,80,WOF_INTERPOLATE); S_WeaponReady(WRF_NOBOB); }
		BASB B 2 { A_WeaponOffset(0,55,WOF_INTERPOLATE); S_WeaponReady(WRF_NOBOB); }
		BASB B 2 { A_WeaponOffset(0,36,WOF_INTERPOLATE); S_WeaponReady(WRF_NOBOB); }
		BASB B 0 A_JumpIf(self.pos.z != GetZAt(self.pos.x, self.pos.y), "Ready");
		BASB B 0 A_Jump(128, "Dribble");
		goto Ready;
	Deselect:
		#### # 0
		{
//			A_StartSound("weapons/shared/switch",32);
//			invoker.switching = true;
			A_WeaponOffset(0,32);
		}
	DeselectLoop:
//		#### # 1 A_SmoothLower;
		#### # 1 A_Lower(15);
		Loop;
	
	NoGrenade:
		TNT1 A 0;
		TNT1 A 0 ACS_NamedExecute("NoNades", 0);
		goto Ready;
	ShatterWindow:
	HandRemovedGrenadeToss:
	HandRemoved:
	HandRemovedBridge:
//	ThrowEquipment: // yeah fuck it, disable grenades, see if I care.
	ReturnHands:
		BASB B 1;
		Goto Ready; 
	Fire:
		TNT1 A 0 {invoker.Nogrenadewhileballin = true;}
		BASB C 2 A_WeaponOffset(0,32,WOF_INTERPOLATE);
		BASB D 2;
		BASB D 1 A_WeaponOffset(0,8,WOF_INTERPOLATE);
		BASB D 1 A_WeaponOffset(0,22,WOF_INTERPOLATE);
		BASB D 2 A_WeaponOffset(0,36,WOF_INTERPOLATE);
		BASB D 2 A_WeaponOffset(0,48,WOF_INTERPOLATE);
		BASB E 0
		{
			// Manually spawn the ball to make sure it bounces.
			// Using A_FireProjectile, the ball will just fall to the ground
			// if thrown point-blank against something.
			// We'll also calculate the forwardvel and sidevel player variables
			// to sync the ball up with the player's forward movement.
			// We're only interested in forward movement,
			// so if it's less than 0, toss it out.
			
			// Thanks D2JK for figuring this formula out!
			invoker.forwardvel = max(0,(sin(angle)*(vel.y)) + (cos(angle)*(vel.x)));
			invoker.sidevel = -((cos(angle)*(vel.y)) - (sin(angle)*(vel.x)));
//			class<Inventory> ballsanity = "PowerBallsanity";
//			if (ballsanity && FindInventory(ballsanity)) {
//				A_SpawnItemEx("Splot_SuperBasketballProjectile",0,0,height*(4./7.),40*cos(pitch)+invoker.forwardvel,invoker.sidevel*0.75,40*-sin(pitch),0,SXF_SETTARGET);
//			} else {
			A_SpawnItemEx("DawnballinProjectile",0,0,height*(4./7.),20*cos(pitch)+invoker.forwardvel,invoker.sidevel*0.75,20*-sin(pitch),0,SXF_SETTARGET);
//			}
			A_StartSound("weapons/sports/bball/throw",CHAN_WEAPON);
			invoker.lookingforrebound = true;
		}
		BASB E 1 A_WeaponOffset(0,-8,WOF_INTERPOLATE);
		BASB E 3 A_WeaponOffset(0,-16,WOF_INTERPOLATE);
		BASB E 1 A_WeaponOffset(0,-12,WOF_INTERPOLATE);
		BASB E 1 A_WeaponOffset(0,-8,WOF_INTERPOLATE);
		BASB E 1 A_WeaponOffset(0,0,WOF_INTERPOLATE);
		BASB E 1 A_WeaponOffset(0,8,WOF_INTERPOLATE);
		BASB E 1 A_WeaponOffset(0,16,WOF_INTERPOLATE);
		BASB E 1 A_WeaponOffset(0,24,WOF_INTERPOLATE);
		BASB E 1 A_WeaponOffset(0,32,WOF_INTERPOLATE);
		
		// If the ball rebounds quickly, it's possible to catch the ball
		// while the throwing animation is still playing. In that case,
		// we do not want to take the ball out of your inventory!
		
		// Picking up a rebound gives you a token that tells us that
		// the player caught the ball. If we don't have this token,
		// remove the weapon. If we DO have the token, take us back
		// to the Select state, like we just picked up the weapon.
		
		// This check is ignored if unlimited ammo is enabled.
		
		// The rebound token is removed during the Select state,
		// as well as any time lookingforrebound is false.
		
		BASB E 0 A_JumpIf(!CountInv("DawnballinReboundCatch") && !CountInv("PowerInfiniteAmmo") && !sv_infiniteammo,"ByeBall");
		BASB E 1 A_WeaponOffset(0,64,WOF_INTERPOLATE);
		BASB E 1 A_WeaponOffset(0,128,WOF_INTERPOLATE);
		TNT1 A 0 
		{
			// Set the sprite back to the y position it had before the
			// SmoothRaise animation, like we're picking it up again.
			
			self.player.GetPSprite(PSP_WEAPON).y = 128;
		}
		Goto Select;
	AltFire:
		// It's dunk time
		// First, check if the player is in water. No dunking in water!
	
		BASB B 0 A_JumpIf(self.waterlevel == 3, "Ready");
		
		// Lanuch the player in the air. If we have the Sports Shoes,
		// prepare the Superdunk by launching the player higher.
		// Set a boolean variable so the Superdunk continues even if
		// we lose the shoes.
		
		BASB B 0
		{
			invoker.SuperDunkState = true;
			A_WeaponOffset(0,32,WOF_INTERPOLATE);
			ThrustThing((angle*256/360),5,0,0);
			ThrustThingZ(0,80,0,0);			
			A_StartSound("weapons/sports/bball/dunkstart", CHAN_WEAPON);
		}
		BASB F 1;
		BASB F 1 A_WeaponOffset(13,-4,WOF_INTERPOLATE);
		BASB F 1 A_WeaponOffset(26,-8,WOF_INTERPOLATE);
		BASB F 1 A_WeaponOffset(39,-12,WOF_INTERPOLATE);
		BASB F 1 A_WeaponOffset(52,-18,WOF_INTERPOLATE);
		BASB F 1 A_WeaponOffset(65,-24,WOF_INTERPOLATE);
		Goto Dunk1;
	Dunk1:
		// This will loop while the player is moving up
		
		BASB G 0;
				
		// If the player is flying, go right for Dunk Phase 3.
		
		BASB G 0 A_JumpIf(self.bFly == true, "Dunk3");
		
		// Using a LineTrace, if we detect an enemy within 64 units
		// in front of us, cut to the dunk. This lets us dunk on airborne
		// enemies or very tall enemies like bosses.
		
		// Because this doesn't start until 6 tics after the dunk begins,
		// it avoids auto-dunking on normal enemies at ground level.
		
		BASB G 1
		{
			FLineTraceData VibeCheck;
			// Check directly ahead, rather than at pitch
			// This helps with consistency if the player is looking up
			LineTrace (angle, 64, 0, offsetz: self.Player.ViewHeight, data: VibeCheck);
			if (VibeCheck.HitType == TRACE_HitActor && VibeCheck.HitActor.bIsMonster)
			{
				return A_JumpIf(256,"Megadunk");
			}
			else
			{
				return state(null);
			}
		}
		
		// Gradually slow down the player's z velocity faster than gravity
		
		BASB G 0 ThrustThingZ(0,1,1,1);
		
		// If we hit the floor while still moving up, cut to the dunk.
		// This could happen if the player lands on a higher floor
		// while dunk-jumping. 
		
		BASB G 0 A_CheckFloor("Megadunk");
		BASB G 0
		{
			if (self.vel.z < 0)
			{
				return A_Jump(256,"Dunk2");
			}
			return state(null);
		}
		Loop;
	Dunk2:
		// Dunk Phase 2
		// Once we've stopped moving up, SLAM down.
	
		BASB G 0
		{
			ThrustThingZ(0,30,1,0);
		}
		Goto Dunk3;
	Dunk3:
		// Dunk Phase 3
		// Perform the same LineTrace check to look for enemies.
		// If we find an enemy, or anything stops our z velocity,
		// or if we hit water, start the dunk effect.
		
		// Dunk Phase 3 also checks if the player is flying.
		// This enables flying dunks. The LineTrace will now check
		// for any obstacle, which also enables a special ball bounce
		// that shoots away from the player.
		// It'll now also check how close the player is to the ground
		// rather than waiting for their z velocity to reach 0.
		
		// If we're somehow going back up (like using the pogo stick),
		// return to the earlier phase of the dunk)
	
		BASB G 1
		{
			FLineTraceData VibeCheck;
			LineTrace (angle, 64, pitch, offsetz: self.Player.ViewHeight, data: VibeCheck);
			if (self.bFly)
			{
				ThrustThing(self.angle*256./360.,3*cos(self.pitch),1,0);
				if (self.pitch > 20)
				{
					invoker.pitchdown = (self.pitch-20)/1.5;
				}
				else { invoker.pitchdown = 0; }
				ThrustThingZ(0,1+invoker.pitchdown,1,1);
				if (VibeCheck.HitType != TRACE_HitNone)
				{
					invoker.flydunk = true;
					return A_JumpIf(256,"Megadunk");
				}
				if (self.pos.z <= (self.GetZAt()+16))
				{
					return A_JumpIf(256,"Megadunk");
				}
				else
				{
					return state(null);
				}
			}
			else
			{
				if (VibeCheck.HitActor is "SOLDIER")
				{
					invoker.flydunk = true;
					return A_JumpIf(256,"Megadunk");
				}
				else
				{
					return state(null);
				}
			}
		}
		BASB G 0 A_JumpIf(self.vel.z > 0,"Dunk1");
		BASB G 0 A_JumpIf(self.vel.z == 0,"Megadunk");
		BASB G 0 A_JumpIf(self.waterlevel >= 1, "Megadunk");
		Loop;
	Megadunk:
		// Here we go!
		
		// Summon a dunk hotspot slightly in front of the player.
		// The dunk hotspot is what creates the dunk explosion.
		// This improves the feel of the dunk by targeting enemies that
		// the player can see rather than enemies behind them.
		// The position of the dunk hotspot is based on the player's pitch,
		// so if you're looking directly down, the hotspot will spawn directly
		// below you.
		
		// If Superdunk is in effect, spawn an even deadlier dunk hotspot.
		
		// If flying dunk is in effect, bounce the ball away from the player
		// since we're slamming into a wall/obstacle.
		
		BASB F 2
		{
			A_WeaponOffset(39,-12,WOF_INTERPOLATE);
			A_SpawnItemEx("Splot_DunkHotspot",cos(self.pitch)*64);
			A_Quake (6,8,0,2048,0);
			ThrustThingZ(0,20,1,1);
			A_StartSound("weapons/sports/bball/dunkslam", 48, CHANF_OVERLAP);
			invoker.lookingforrebound = true;
		}
		BASB H 1
		{
			if (invoker.flydunk == false)
			{
				invoker.forwardvel = (sin(angle)*(vel.y)) + (cos(angle)*(vel.x));
				invoker.sidevel = -((cos(angle)*(vel.y)) - (sin(angle)*(vel.x)));
				A_SpawnItemEx("DawnballinProjectile",0,0,0,(random(-3,3)+(invoker.forwardvel*0.5)),(random(-3,3)+(invoker.sidevel*0.5)),random(10,18));
			}
			
			else
			{
				int randomdunkspeed = random(10,18);
				A_SpawnItemEx("DawnballinProjectile",-self.radius,0,0,((randomdunkspeed-2)*-cos(self.pitch))+2,randomdunkspeed*sin(self.pitch),randomdunkspeed*sin(self.pitch));
				
			}
			invoker.flydunk = false;
		}
		BASB H 1 A_WeaponOffset(0,12,WOF_INTERPOLATE);
		BASB H 1 A_WeaponOffset(0,24,WOF_INTERPOLATE);
		BASB H 1 A_WeaponOffset(0,48,WOF_INTERPOLATE);
		BASB H 1 A_WeaponOffset(0,60,WOF_INTERPOLATE);
		TNT1 A 5;
		BASB H 0 A_JumpIf(!CountInv("DawnballinReboundCatch") && !CountInv("PowerInfiniteAmmo") && !sv_infiniteammo,"ByeBall");
		BASB H 0
		{	
			self.player.GetPSprite(PSP_WEAPON).y = 128;
		}
		Goto Select;
	Byeball:
		// GZDoom very rarely crashes when removing Dawnballin from
		// the player's inventory in the middle of a state, so we'll
		// move that action to a separate dead-end state that
		// doesn't continue on to anything.
		TNT1 A 0 {
			A_TakeInventory("Dawnballin");
		}
		Stop;
	DeadLowered:
		TNT1 A -1;
		Stop;
	
	Spawn:
		BASB A -1;
		Stop;
//	}
	

//======================SLIDES====================//
	SLIDE_Transition:
		TNT1 A 1 {
			A_TakeInventory("ShieldEyes", 1);
			X_SetOverlaySprite(1, invoker.SlidingSprite, invoker.slideFrame);
			//if(invoker.cameraMotion == 1) {
				//A_SETROLL(roll+0.5, SPF_INTERPOLATE); This was causing some issues with interpolation, disabled for now!
			//}
			S_ZOOMFACTOR(invoker.slideZoom);
			invoker.slideTransition++;
			if(getCvar("g_slidezooming") == 1 && getCvar("fov") < 120) {
				invoker.slideZoom = invoker.slidezoom - 0.02;
			}
			if(invoker.slideTransition % 2 == 0) {
				invoker.slideFrame++;
			}
			if(invoker.slideFrame == 2) {
				SetWeaponState("SLIDE_ShowDawnLegs");
			}
			A_SlideRumble();
			if(invoker.slideShake) 
			{
             A_QuakeEx(frandom(0,0.6), frandom(0,0.6), frandom(0,0.1), 2, 0, 700, 0, 0, 0, 0, 0, 0, frandom(0, 0.6), frandom(0, 0.6), frandom(0, 0.6));
			}
				}
		loop;

	SLIDE_ShowDawnLegs:
		TNT1 A 1 {
			invoker.activeSlideState = true;
			A_SlideRumble();
			X_SetOverlaySprite(1, invoker.SlidingSprite, 2);
			A_ZOOMFACTOR(invoker.slideZoom);
			invoker.legSprite = 100;
			A_OVERLAY(-400, "FirstPersonLegsStand");
		}
		goto Slidelooper;

	SlideLooper:
		TNT1 A 1 {
				A_SlideRumble();
				if(invoker.slideShake) {
					A_QuakeEx(frandom(0,0.5), frandom(0,0.5), frandom(0,0.1), 2, 0, 700, 0, 0, 0, 0, 0, 0, frandom(0, 0.45), frandom(0, 0.45), frandom(0, 0.45));
				}
				X_SetOverlaySprite(1, invoker.SlidingSprite, invoker.slideFrame);
				CheckPlayerStates();
				A_ZOOMFACTOR(invoker.slidezoom);
				S_WeaponReady();
				S_WeaponOffset(frandom(-1,1), frandom(-1,1));
				// If slidekick failed, try punt
				if(player.mo is "Dawn") {
					Dawn(player.mo).puntObject();
				}
			}
      TNT1 A 0 A_JumpIfInventory("StopSliding", 1, "SLIDE_ExitTransition");
		loop;

	StoppedSliding:
		TNT1 A 0 {
         //invoker.displayNumber--;
			A_Playsound("impact/slideend", CHAN_6, 0.6);
			A_TakeInventory("StopSliding", 1);
			A_TakeInventory("SlidingIsActive", 1);
			A_TakeInventory("PlayerSlides", 1);
			SetWeaponState("SLIDE_ExitTransition");
		}

	SLIDE_ExitTransition:
		TNT1 A 1 {
			A_StopSound(CHAN_5);
			X_SetOverlaySprite(1, invoker.SlidingSprite, invoker.slideFrame);
			S_ZOOMFACTOR(invoker.slideZoom);
			invoker.slideTransition--;
			if(getCvar("fov") < 120) {
				invoker.slideZoom = invoker.slidezoom + 0.015;
			}
			if(invoker.slideTransition % 2 == 0) {
				invoker.slideFrame--;
			}
			if(invoker.slideFrame == 0) {
				invoker.slideTransition = 0;
				invoker.SlideFrame = 0;
				invoker.SlideZoom = 1.00;
				SetWeaponState("Ready");
			}
		}
		loop;
//====================GRENADES=====================//

ThrowGrenade:
		TNT1 A 0 A_GiveInventory("CancelAnimation", 1);
		TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo", 1, 1);
		Goto NoGrenade;
		TNT1 A 0 A_ClearOverlays(2, 3);
		TNT1 A 0 A_ZoomFactor(1.0);
		TNT1 A 0 setZoomStatus(false);
		TNT1 A 0 A_overlay(PSP_OFFHAND, "ThrowGrenadeAnimation");
		BASB BBBFFFGGGGGGGGGGGGGGGGFF 1;
		TNT1 A 0 {
			if(countinv("HandGrenadeAmmo") == 0) {
				SetWeaponState("SwitchEquipment");
			}
			SetWeaponState("HandRemovedGrenadeToss");
			return;
		}
		Goto HandRemovedGrenadeToss;
		
	ThrowMine:
		TNT1 A 0 {
			if(countinv("MineAmmo") == 0) {
				SetWeaponState("NoGrenade");
			}
		}
		TNT1 A 0 A_ClearOverlays(2, 3);
		TNT1 A 0 A_ZoomFactor(1.0);
		TNT1 A 0 A_TakeInventory("UseGadget", 1);
		TNT1 A 0 A_JumpIfInventory("MineAmmo", 1, 1);
		NULL A 0 A_PlaySound("StunGrenadeArm", 2);
		TNT1 A 0 setZoomStatus(false);
		TNT1 A 0 A_overlay(PSP_OFFHAND, "ThrowMineAnimation");
		BASB BBBFFFGGGGGGGGGGGGGGGGFF 1;
		TNT1 A 0
		{
			SetWeaponState("HandRemovedGrenadeToss");
			return;
		}
		goto HandRemovedGrenadeToss;	
			
	ThrowIceGrenade:
		TNT1 A 0 {
			if(countinv("IceGrenadeAmmo") == 0) {
				SetWeaponState("NoGrenade");
			}
		}
		TNT1 A 0 A_GiveInventory("CancelAnimation", 1);
		TNT1 A 0 A_ZoomFactor(1.0);
		TNT1 A 0 A_JumpIfInventory("IceGrenadeAmmo", 1, 1);
		Goto NoIceGrenade;
		TNT1 A 0 A_ClearOverlays(2, 3);
		TNT1 A 0 setZoomStatus(false);
		TNT1 A 0 A_overlay(PSP_OFFHAND, "ThrowIceGrenadeAnimation");
		TNT1 A 0
		{
			SetWeaponState("HandRemovedGrenadeToss");
			return;
		}
		Goto HandRemovedGrenadeToss;
		
//=============================pushing button================================//
		
	PushButton:
		TNT1 A 0 {invoker.Nogrenadewhileballin = true;}
		TNT1 A 0 A_TakeInventory("PushButtonNow", 1);
		TNT1 A 0 {
			invoker.isZooming = false;
			if (getCvar("g_interactionanimations") == 1) {
				SetWeaponState("PushButtonAnimationbball");
			}
		}
		goto Ready;
		
	PushButtonAnimationbball:	
		TNT1 A 0;
		TNT1 A 0 {
			ACS_NamedExecute("RemoveHand", 0);
			invoker.isPushingButton = true;
		}
		TNT1 A 10;
		HND2 CCDDEE 1 A_JumpIfInventory("CancelAnimation", 1, "CancelAnimatonProcess");
		HND2 EEEE 1 A_JumpIfInventory("CancelAnimation", 1, "CancelAnimatonProcess");
		TNT1 A 0 {
			invoker.isPushingButton = false;
		}
		HND2 CCBBAA 1 A_JumpIfInventory("CancelAnimation", 1, "CancelAnimatonProcess");
		TNT1 A 0 {
			A_TakeInventory("PushButtonNow", 1);
