class Splot_DunkHotspot : Actor
{
	Default
	{
		Radius 1;
		Height 1;
		+NOGRAVITY
		+NOCLIP
		+NOBLOCKMAP
		+DONTSPLASH
	}
	
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 0
		{
			A_Explode(175,80,0,0,64,0,0,"","Extreme");
			bNOEXTREMEDEATH = true;
			A_Explode(75,180,0,0,80);
			A_SpawnItemEx("Splot_Shockwave");
			
			for (int i; i < 6; i++)
			{
				A_SpawnItemEx("Splot_Debris",random(-64,64),random(-64,64),8,0,random(0,3),random(5,9),random(0,360));
			}
			
			for (int i; i < 24; i++)
			{
				A_SpawnItemEx("Splot_DebrisTiny",random(-64,64),random(-64,64),8,0,random(0,3),random(3,7),random(0,360));
			}
			
			// A_DunkDown is a custom script that slams down airborne enemies
			// in the dunk zone. We call A_DunkDown after the explosion so
			// the enemies don't get launched upwards with the other riff-raff.
		
			A_DunkDown();
		}
		Stop;
	}
	
	// This script is based on A_Blast, but with a modification to look
	// for the edge of a monster's collision radius rather than the center.
	// This improves the dunk slamdown consistency on large enemies.
	
	action void A_DunkDown()
	{
		ThinkerIterator it = ThinkerIterator.Create("Actor");
		Actor mo;
		while ( (mo = Actor(it.Next ())) )
		{
			if (mo == self || mo.bBoss || mo.bDormant || mo.bMissile)
			{
				continue;
			}
			if (mo.bIceCorpse || mo.bCanBlast)
			{
				// it's okay
			}
			else if (!mo.player && !mo.bIsMonster && !mo.bCanBlast && !mo.bVulnerable)
			{
				continue;
			}
			if (Distance2D(mo) > (80+mo.radius)) // dunk slamdown from edge of monster radius
			{
				continue;
			}
			if (mo.CurSector.PortalGroup != CurSector.PortalGroup && !CheckSight(mo))
			{
				// in another region and cannot be seen.
				continue;
			}
			if (mo.pos.z <= GetZAt(mo.pos.x,mo.pos.y))
			{
				continue;
			}
			mo.Vel.Z = -20;
		}
	}
}

